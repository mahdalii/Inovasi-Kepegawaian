# Flask secret key (optional, will generate random if not set)
SECRET_KEY=

# Staff login password
STAFF_PASSWORD=admin123

# --- Gmail SMTP (untuk notifikasi email) ---
# 1. Aktifkan 2FA di akun Google Anda di https://myaccount.google.com/security
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Generate app password (pilih "Mail" + "Other")
# 4. Copy 16-char password di bawah
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
